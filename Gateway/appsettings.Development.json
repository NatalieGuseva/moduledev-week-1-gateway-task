{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Yarp": "Debug"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "all-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api-destination": {
            "Address": "http://localhost:8081/"
          }
        }
      }
    }
  }
}